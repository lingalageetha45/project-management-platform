# Application
APP_NAME=ProjectFlow
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-very-long-random-string-in-production-at-least-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/projectflow
# For local non-docker: postgresql://postgres:postgres@localhost:5432/projectflow

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]

# Super Admin bootstrap (created on first run if not exists)
FIRST_SUPERUSER_EMAIL=superadmin@projectflow.local
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password
